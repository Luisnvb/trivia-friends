# Copiar a .env.local y rellenar con la connection string real de Neon.
# No versionar .env.local (ver .gitignore).
DATABASE_URL="postgres://<usuario>:<password>@<host>.neon.tech/<database>?sslmode=require"

# Clave compartida exigida para crear/editar preguntas, notas de episodio y
# datos de la serie (ver src/lib/auth/edit-key.ts). Elige cualquier valor.
EDIT_PASSWORD="<clave>"
